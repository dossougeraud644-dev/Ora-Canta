<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ora &amp; Canta – Partitions</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Lato:wght@400;700&amp;display=swap" rel="stylesheet">
<style>
:root{--bg:#FDFDF6;--surf:#fff;--ink:#0B1F3F;--mut:#5a6577;--gold:#B8861B;--line:#e6e1cf;--chip:#f4ecd3;--on-gold:#fff;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0B1730;--surf:#12224a;--ink:#f3efe0;--mut:#aab4c8;--gold:#E2B24A;--line:#2a3b66;--chip:#1d2f5c;--on-gold:#0B1730;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0B1730;--surf:#12224a;--ink:#f3efe0;--mut:#aab4c8;--gold:#E2B24A;--line:#2a3b66;--chip:#1d2f5c;--on-gold:#0B1730;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*:before,*:after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 Lato,system-ui,sans-serif}
h1,h2,h3{font-family:'Cormorant Garamond',Georgia,serif;margin:0}
.hero{background:#FDFDF6;color:#0B1F3F;text-align:center;padding:28px 16px 22px;border-bottom:3px solid #B8861B}
.hero img{width:min(300px,70vw);height:auto;display:block;margin:0 auto}
.hero p{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(1.25rem,4.5vw,1.7rem);font-style:italic;margin:6px 0 14px}
nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
nav a{color:#0B1F3F;text-decoration:none;font-weight:700;padding:8px 16px;border:1.5px solid #B8861B;border-radius:99px}
nav a:hover,nav a:focus-visible{background:#B8861B;color:#fff;outline:none}
main,section{max-width:1100px;margin:0 auto;padding:32px 16px}
h2{font-size:2rem;color:var(--ink);margin-bottom:14px;border-left:5px solid var(--gold);padding-left:12px}
.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-bottom:18px}
input,select,button{font:inherit}
input,select{width:100%;padding:10px 12px;border:1.5px solid var(--line);border-radius:8px;background:var(--surf);color:var(--ink)}
input:focus,select:focus,button:focus-visible,a:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.card{background:var(--surf);border:1px solid var(--line);border-top:4px solid var(--gold);border-radius:10px;padding:16px;display:flex;flex-direction:column;gap:10px}
.card h3{font-size:1.45rem;line-height:1.15}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{background:var(--chip);border-radius:99px;padding:2px 10px;font-size:.82rem;color:var(--ink)}
.meta{color:var(--mut);font-size:.9rem;margin:0}
.btn{display:inline-block;text-align:center;background:var(--gold);color:var(--on-gold);font-weight:700;border:0;border-radius:8px;padding:10px 14px;text-decoration:none;cursor:pointer}
.btn.off{opacity:.5;pointer-events:none}
.btn.alt{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.by{margin:auto 0 0;padding-top:10px;border-top:1px solid var(--line);color:var(--mut);font-size:.9rem;font-style:italic}
.empty{color:var(--mut);padding:24px 0}
.tels{display:flex;flex-direction:column;gap:10px;max-width:360px}
.tels a{font-size:1.15rem;padding:12px 14px}
.bar{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:var(--chip);border-radius:10px;padding:10px 14px;margin-bottom:18px}
.adm{display:flex;gap:6px}
.form{background:var(--surf);border:1.5px solid var(--gold);border-radius:10px;padding:16px;margin-bottom:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.form label{display:flex;flex-direction:column;gap:4px;font-size:.9rem;color:var(--mut)}
.form .full{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap}
.msg{color:var(--gold);font-weight:700}
footer{text-align:center;color:var(--mut);padding:24px 16px 32px;font-size:.9rem}
</style></head><body>
<header class="hero">
<img src="data:image/jpeg;base64," alt="Logo Ora &amp; Canta">
<p>Une voix, une prière, une communauté</p>
<nav><a href="#nouveautes">Nouveautés</a><a href="#partitions">Partitions</a><a href="#apropos">À propos</a><a href="#contact">Contact</a></nav>
</header>
<div id="app"></div>
<section id="apropos"><h2>À propos</h2>
<p style="max-width:62ch">Ora &amp; Canta est un groupe de choristes engagés au service de la liturgie. Nos partitions, écrites à quatre voix, sont mises gratuitement à la disposition des chorales et des communautés.</p>
<p style="max-width:62ch">Toutes les œuvres présentées sur ce site sont composées ou arrangées par nos membres. Pour toute question ou proposition, contactez-nous par téléphone.</p></section>
<section id="contact"><h2>Contact</h2><div class="tels">
<a class="btn" href="tel:+2290161966177">+229 01 61 96 61 77</a>
<a class="btn" href="tel:+2290144688112">+229 01 44 68 81 12</a>
<a class="btn" href="tel:+2290147853982">+229 01 47 85 39 82</a></div></section>
<footer>© Ora &amp; Canta – Partitions à quatre voix</footer>
<script type="application/json" id="data">{"scores":[{"id":"s1792664765275","title":"Je t'aime Seigneur","composer":"DAFIO Urbain","kind":"Autre","season":"Temps ordinaire","level":"Facile","key":"Fa","pages":1,"url":"data:application/pdf;base64,","date":"2026-10-22"},{"id":"s1792664845071","title":"Je t'aime Seigneur","composer":"DOSSOU Jean Jaurès","kind":"Autre","season":"Temps ordinaire","level":"Facile","key":"Fa#m","pages":1,"url":"data:application/pdf;base64,","date":"2026-10-22"}]}</script>
<script>
const KINDS=["Entrée","Kyrie","Gloria","Acclamation","Offertoire","Sanctus","Agnus Dei","Communion","Action de grâce","Envoi","Autre"];
const SEASONS=["Avent","Noël","Carême","Pâques","Temps ordinaire","Toute l’année"];
let state;try{state=JSON.parse(document.getElementById('data').textContent)}catch(e){state={scores:[]}}
const admin=/[?&]admin/.test(location.search);
let editing=null,dirty=false,note='',F={q:'',c:'',k:'',s:''};
const $=(s,r=document)=>r.querySelector(s);
const esc=t=>String(t??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const opts=(a,v)=>a.map(x=>`<option${x===v?' selected':''}>${esc(x)}</option>`).join('');
function card(s){const ex=[s.level,s.key&&'Ton : '+s.key,s.pages&&s.pages+' p.'].filter(Boolean).join(' · ');
return `<article class="card"><h3>${esc(s.title)}</h3><div class="chips"><span class="chip">${esc(s.kind)}</span><span class="chip">${esc(s.season)}</span><span class="chip">4 voix</span></div>
${ex?`<p class="meta">${esc(ex)}</p>`:''}
${s.url?`<a class="btn" href="#" data-dl="${s.id}">Télécharger le PDF</a>`:`<span class="btn off">PDF bientôt disponible</span>`}
${admin?`<div class="adm"><button class="btn alt" data-ed="${s.id}">Modifier</button><button class="btn alt" data-del="${s.id}">Supprimer</button></div>`:''}
<p class="by">Composé par ${esc(s.composer)}</p></article>`}
function list(){const q=F.q.toLowerCase();return state.scores.filter(s=>(!q||s.title.toLowerCase().includes(q))&&(!F.c||s.composer===F.c)&&(!F.k||s.kind===F.k)&&(!F.s||s.season===F.s)).sort((a,b)=>b.date.localeCompare(a.date))}
function grid(){const l=list();$('#grid').innerHTML=l.length?l.map(card).join(''):'<p class="empty">Aucune partition ne correspond à votre recherche.</p>'}
function form(){const s=editing==='new'?{}:state.scores.find(x=>x.id===editing)||{};
return `<div class="form" id="form"><label>Titre *<input id="f-title" value="${esc(s.title)}"></label><label>Compositeur / arrangeur *<input id="f-comp" value="${esc(s.composer)}"></label>
<label>Type de chant *<select id="f-kind">${opts(KINDS,s.kind)}</select></label><label>Temps liturgique *<select id="f-season">${opts(SEASONS,s.season)}</select></label>
<label>Niveau<select id="f-level"><option value="">–</option>${opts(["Facile","Moyen","Avancé"],s.level)}</select></label><label>Tonalité<input id="f-key" value="${esc(s.key)}"></label>
<label>Nombre de pages<input id="f-pages" type="number" min="1" value="${esc(s.pages)}"></label><label>Fichier PDF ${s.url?'(vide = garder l’actuel)':'*'}<input id="f-pdf" type="file" accept="application/pdf"></label>
<div class="full"><button class="btn" id="save">Enregistrer</button><button class="btn alt" id="cancel">Annuler</button><span class="msg" id="msg"></span></div></div>`}
function render(){const nv=[...state.scores].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,3);
const comps=[...new Set(state.scores.map(s=>s.composer))].sort();
$('#app').innerHTML=`${admin?`<section style="padding-bottom:0"><div class="bar"><strong>Mode administrateur</strong><span class="adm"><button class="btn" id="add">Ajouter une partition</button><button class="btn alt" id="export">Télécharger le site mis à jour</button></span><span class="msg" style="flex-basis:100%">${esc(note)}</span></div>${editing?form():''}</section>`:''}
<section id="nouveautes"><h2>Nouveautés</h2><div class="grid">${nv.map(card).join('')||'<p class="empty">Aucune partition pour le moment.</p>'}</div></section>
<section id="partitions"><h2>Partitions</h2><div class="filters"><input id="q" type="search" placeholder="Rechercher un titre" value="${esc(F.q)}" aria-label="Rechercher un titre">
<select id="fc" aria-label="Compositeur"><option value="">Tous les compositeurs</option>${opts(comps,F.c)}</select>
<select id="fk" aria-label="Type de chant"><option value="">Tous les types de chant</option>${opts(KINDS,F.k)}</select>
<select id="fs" aria-label="Temps liturgique"><option value="">Tous les temps liturgiques</option>${opts(SEASONS,F.s)}</select></div><div class="grid" id="grid"></div></section>`;
grid()}
const readFile=f=>new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>ok(r.result);r.onerror=ko;r.readAsDataURL(f)});
function saveBlob(blob,name){const u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),4000)}
async function save(){const t=$('#f-title').value.trim(),c=$('#f-comp').value.trim(),f=$('#f-pdf').files[0],m=$('#msg');
const old=editing!=='new'?state.scores.find(x=>x.id===editing):null;
if(!t||!c||(!f&&!(old&&old.url))){m.textContent='Renseignez le titre, le compositeur et le PDF.';return}
if(f&&f.size>8e6){m.textContent='PDF trop lourd (8 Mo maximum).';return}
try{const url=f?await readFile(f):(old?old.url:'');
const s={id:old?old.id:'s'+Date.now(),title:t,composer:c,kind:$('#f-kind').value,season:$('#f-season').value,level:$('#f-level').value,key:$('#f-key').value.trim(),pages:+$('#f-pages').value||'',url,date:old?old.date:new Date().toISOString().slice(0,10)};
state.scores=old?state.scores.map(x=>x.id===s.id?s:x):[...state.scores,s];editing=null;dirty=true;note='Enregistré. Pensez à télécharger le site mis à jour, puis à le remettre en ligne.';render()}
catch(e){m.textContent='Échec de l’enregistrement. Réessayez.'}}
function exportSite(){const c=document.documentElement.cloneNode(true);$('#app',c).innerHTML='';$('#data',c).textContent=JSON.stringify(state).replace(/</g,'\\u003c');
saveBlob(new Blob(['<!DOCTYPE html>\n'+c.outerHTML],{type:'text/html'}),'index.html');dirty=false;note='Fichier index.html téléchargé : remplacez l’ancien sur votre hébergement.';render()}
async function dl(id){const s=state.scores.find(x=>x.id===id);if(!s)return;const b=await (await fetch(s.url)).blob();saveBlob(b,s.title.replace(/[^\p{L}\p{N}]+/gu,'-')+'.pdf')}
document.addEventListener('input',e=>{if(e.target.id==='q'){F.q=e.target.value;grid()}});
document.addEventListener('change',e=>{const m={fc:'c',fk:'k',fs:'s'}[e.target.id];if(m){F[m]=e.target.value;grid()}});
document.addEventListener('click',e=>{const t=e.target.closest('[data-dl],[data-ed],[data-del],button')||e.target;
if(t.dataset.dl){e.preventDefault();dl(t.dataset.dl)}
else if(t.id==='add'){editing='new';render()}else if(t.id==='cancel'){editing=null;render()}else if(t.id==='save')save();else if(t.id==='export')exportSite();
else if(t.dataset.ed){editing=t.dataset.ed;render();scrollTo({top:0})}
else if(t.dataset.del&&confirm('Supprimer cette partition ?')){state.scores=state.scores.filter(x=>x.id!==t.dataset.del);dirty=true;note='Partition supprimée. Téléchargez le site mis à jour.';render()}});
addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue=''}});
render();
</script>
</body></html>
